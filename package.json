{
  "name": "fincore-cypress-suite",
  "version": "1.0.0",
  "description": "FinCore Bank \u2014 banking QA practice app with an end-to-end + API test suite built in Cypress",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:schema": "psql \"$DATABASE_URL\" -f db/schema.sql",
    "db:seed": "node db/seed.js",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:chrome": "cypress run --browser chrome",
    "test": "cypress run"
  },
  "keywords": [
    "cypress",
    "qa",
    "e2e",
    "api-testing",
    "banking"
  ],
  "author": "Hathim Al Ghifari",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@faker-js/faker": "^8.4.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "nodemon": "^3.1.14",
    "pg": "^8.21.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "cypress": "13.17.0"
  }
}
